# MCP HTTP Server
PORT=3000
MCP_AUTH_TOKEN=

# Instagram / Meta
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=

# Meta-Webhook fuer Instagram-Kommentare (Panel v11, sofortige Antwort statt nur Cron) - eigener
# Wert, mit `openssl rand -hex 32` erzeugen, dann bei der Webhook-Einrichtung im Meta-Dashboard
# exakt so als "Verify Token" eintragen. Ohne diesen Wert (leer) schlaegt der Verify-Handshake
# immer fehl (fail-closed), das Feature ist dann einfach inaktiv - kein Fehler.
IG_WEBHOOK_VERIFY_TOKEN=

# Cloudflare R2 (Bild-Hosting)
MEDIA_STORAGE_BUCKET_URL=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_BUCKET_NAME=

# fal.ai (Bildgenerierung)
FAL_API_KEY=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# Sofort-Trigger fuer die "Pipeline Kunden-Loop"-Routine (Jetzt posten / Freigeben) - optional,
# ohne beide Werte laeuft die Routine unveraendert nur nach ihrem Stunden-Zeitplan.
# Einmalig manuell erzeugen: claude.ai/code/routines -> Routine "Pipeline Kunden-Loop" -> Stift-Icon
# -> "Add another trigger" -> "API" -> URL kopieren, "Generate token" klicken, Token SOFORT kopieren
# (wird nur einmal angezeigt). Siehe docs/ROUTINE_TEIL_A.md.
ROUTINE_TRIGGER_URL=
ROUTINE_TRIGGER_TOKEN=

# Cloudflare Turnstile (Panel v6, Aufgabe 2a) - CAPTCHA am Signup-Formular. Kostenlos, kein
# Cloudflare/DNS-Umzug noetig (Turnstile funktioniert auf jeder Website). Einrichten unter
# https://dash.cloudflare.com/?to=/:account/turnstile -> "Add widget" -> Domain(s) eintragen,
# Widget-Modus "Managed" reicht. Site-Key ist oeffentlich (geht ans Frontend), Secret-Key bleibt
# hier in der .env. Ohne beide Werte bleibt CAPTCHA deaktiviert (kein Fehler, siehe Report).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google-Unternehmensprofil (Google Business Profile) - automatische Antworten auf Google-
# Bewertungen. ACHTUNG, nicht self-service: der API-Zugang muss bei Google beantragt und
# freigegeben werden, bis dahin liefert jeder Aufruf einen Fehler (Kontingent 0/Minute). Ganze
# Voraussetzungsliste und Antragsweg: docs/GOOGLE_BUSINESS_PROFILE_API.md.
# Solange beide Werte leer sind, taucht der Kanal im Panel gar nicht auf (kein Verbinden-Knopf,
# keine Einstellungen) - das Panel verhaelt sich exakt wie vorher.
# OAuth-Client (Typ "Webanwendung") in der Google Cloud Console anlegen, als autorisierte
# Weiterleitungs-URI die Panel-Adresse + /callback/google eintragen, z.B.
# https://mcp.pipebot.at/panel/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Text-to-Speech - Sprachausgabe der Video-Diashows (siehe src/tts.ts).
# Reiner API-Schluessel (kein OAuth), in der Google Cloud Console erzeugen und dort auf die
# Text-to-Speech-API einschraenken. Preis: 4 USD je 1 Mio. Zeichen (WaveNet), 4 Mio. Zeichen pro
# Monat frei - ein 10-Sekunden-Video braucht rund 150 Zeichen.
# Ohne diesen Wert laeuft die Video-Diashow weiter, nur eben stumm (der Text steht ohnehin im
# Bild), und der Vorhoer-Knopf im Panel sagt ehrlich, dass er gerade nicht kann.
GOOGLE_TTS_API_KEY=

# Optional, nur falls das Rendern den Server zu stark belastet:
# VIDEO_RENDER_CONCURRENCY=1   # wie viele Videos gleichzeitig gerendert werden (Standard 1)
# VIDEO_FFMPEG_PRESET=medium   # x264-Preset; schnellere Presets bringen hier kaum etwas (gemessen)
# PANEL_VIDEO_CRON_MINUTES=30  # wie oft nachgesehen wird, ob ein Video faellig ist
