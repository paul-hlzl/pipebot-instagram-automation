{
  "name": "instagram-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that publishes Instagram feed posts via the Instagram Graph API",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:limit": "tsx scripts/check-limit.ts",
    "pretest:panel": "pm2 restart instagram-mcp-staging > /dev/null",
    "test:panel": "node scripts/test-panel.mjs",
    "test:watermark": "node scripts/test-watermark.mjs",
    "backup:db": "node scripts/backup-db.mjs"
  },
  "keywords": [
    "mcp",
    "instagram",
    "claude"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
